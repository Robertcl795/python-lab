  "scripts": {
    "dev": "nx run-many --target=serve --projects=editor,movies,shell --parallel=3",
    "dev:shell": "nx serve shell --port=4200",
    "dev:editor": "nx serve editor --port=4201",
    "dev:movies": "nx serve movies --port=4202",
    "dev:remotes": "nx run-many --target=serve --projects=editor,movies --parallel=2",
    "build": "nx run-many --target=build --projects=shell,editor,movies --parallel=3",
    "build:shell": "nx build shell --configuration=production",
    "build:editor": "nx build editor --configuration=production",
    "build:movies": "nx build movies --configuration=production",
    "test": "nx run-many --target=test --projects=shell,editor,movies",
    "lint": "nx run-many --target=lint --projects=shell,editor,movies",
    "e2e": "nx e2e shell-e2e"
  },
